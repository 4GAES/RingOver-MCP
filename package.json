{
  "name": "ringover-analitica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Analítica diaria de llamadas de Ringover (España) con panel web y servidor MCP",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n center,api,web -c gray,blue,magenta \"npm:dev:center\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:center": "node scripts/mock-center.mjs",
    "dev:api": "node --env-file-if-exists=.env.dev --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build && node --import tsx scripts/prerender.tsx",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
