# Copia a .env (producción) o .env.dev (local). Nunca subas el fichero real.
PORT=3020
DB_PATH=./data/ringover.db
# Clave de la API de Ringover (en producción se importa de ControlTower con deploy/importar-clave.sh)
RINGOVER_API_KEY=
RINGOVER_BASE_URL=https://public-api.ringover.com/v2
# Backend de 4Geeks Center (ControlTower): mismo login y permisos
CENTER_URL=http://127.0.0.1:8003
CENTER_CALLS_SLUG=admisiones-contactabilidad
# Token para el endpoint MCP (Authorization: Bearer ...)
MCP_TOKEN=
# Cookies Secure (true detrás de HTTPS)
COOKIE_SECURE=true
# Desactiva la sincronización con Ringover (desarrollo con datos de demo)
SYNC_ENABLED=true
# Login con Google Workspace: cliente OAuth y dominio permitido
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=tu-empresa.com
# Admins fijos (siempre entran y gestionan la lista de usuarios), separados por comas
ADMIN_EMAILS=admin@tu-empresa.com
# Formulario de la landing: aviso por Brevo
BREVO_API_KEY=
LEADS_TO=ventas@tu-empresa.com
LEADS_FROM=avisos@tu-empresa.com
